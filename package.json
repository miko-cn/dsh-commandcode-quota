{
  "name": "@yumiku/dsh-commandcode-quota",
  "version": "1.1.0",
  "type": "module",
  "description": "Command Code usage panel for DeepSeek Harness: plan credits, 5-hour/weekly windows, period request stats, plan tiers, and an API key editor — as a Settings tab plus a draggable floating capsule.",
  "license": "MIT",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "commandcode",
    "usage",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miko-cn/dsh-commandcode-quota.git"
  },
  "homepage": "https://github.com/miko-cn/dsh-commandcode-quota#readme",
  "bugs": {
    "url": "https://github.com/miko-cn/dsh-commandcode-quota/issues"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:index": "node scripts/build-index.mjs",
    "validate:index": "node scripts/validate-index.mjs",
    "check:locales": "node scripts/check-locales.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-alpha.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
