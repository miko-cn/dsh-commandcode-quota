{
  "name": "@local/commandcode-quota",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Command Code usage panel for DeepSeek Harness: plan credits, 5-hour/weekly windows, period request stats, plan tiers, and an API key editor — as a Settings tab plus a draggable floating capsule.",
  "license": "MIT",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "commandcode",
    "usage",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miko-cn/dsh-commandcode-quota.git"
  },
  "homepage": "https://github.com/miko-cn/dsh-commandcode-quota#readme",
  "bugs": {
    "url": "https://github.com/miko-cn/dsh-commandcode-quota/issues"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
